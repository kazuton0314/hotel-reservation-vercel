# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Sheets API（読み取り専用サービスアカウント）
GOOGLE_SERVICE_ACCOUNT_EMAIL=sync@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google カレンダー（施設共有カレンダー ID）
# カレンダー設定 → カレンダーの統合 → カレンダーID（...@group.calendar.google.com）
# サービスアカウントのメールを「変更権限」で共有してください
GOOGLE_CALENDAR_ID=xxxxxxxx@group.calendar.google.com

# フォーム回答スプシ（テスト用 ID の例。本番切替時はここだけ差し替え）
GOOGLE_BOOKING_FORM_SPREADSHEET_ID=1AkN0BOrB1PAhiy0rGTLbY7CDtf8toYJhD3OFVPvhw4M
GOOGLE_REQUEST_FORM_SPREADSHEET_ID=1rG6bYt3LnbHuu3Ck4kCdqjx7DHWYGwr2aHHgIR_Jo6Q
# GOOGLE_BOOKING_FORM_SHEET_NAME=シート1
# GOOGLE_REQUEST_FORM_SHEET_NAME=シート1

# Vercel Cron 保護
CRON_SECRET=your-random-secret

# フォーム同期の一時停止（障害復旧中は true）
# FORM_SYNC_DISABLED=true

# メール送信
# ローカル開発: さくら SMTP（自宅/オフィスの国内IPから接続）
# Vercel 本番: Resend 推奨（さくらSMTPはクラウドIPから 550 で拒否されやすい）
MAIL_PROVIDER=smtp
FACILITY_NAME=みどりの時計台
MAIL_FROM=みどりの時計台 <info@midorinotokeidai.com>
# MAIL_FROM_ADDRESS=info@midorinotokeidai.com
# MAIL_FROM_NAME=みどりの時計台
# MAIL_REPLY_TO=info@your-domain.jp
SMTP_HOST=【さくらのSMTPサーバ名】
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@your-domain.jp
SMTP_PASS=メールボックスのパスワード

# SMTP送信後、IMAPでWebメールの送信済みフォルダへコピーする
# 未設定の場合は SMTP_HOST / SMTP_USER / SMTP_PASS を流用します
# IMAP_SAVE_SENT=false で無効化できます
# IMAP_HOST=【さくらのIMAPサーバ名】
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=info@your-domain.jp
# IMAP_PASS=メールボックスのパスワード
# IMAP_SENT_MAILBOX=Sent

# {{本予約URL}} に差し込む本予約フォーム URL
STUDIO_BOOKING_FORM_URL=https://your-domain.jp/booking

# Vercel 本番向け（MAIL_PROVIDER=resend）
# Resend で midorinotokeidai.com をドメイン認証後、以下を Vercel に設定
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM_ADDRESS=tomaro@midorinotokeidai.com
# MAIL_FROM_NAME=みどりの時計台
# RESEND_WEBHOOK_SECRET=（任意・配信イベント用）

# アプリURL（同行者フォームリンク生成）
NEXT_PUBLIC_APP_URL=http://localhost:3000
